# ==========================================================
# AI Search Engine - Environment Configuration
# Copy this file to ".env" and fill in your own values.
# Never commit your real ".env" file to version control.
# ==========================================================

# ---- OpenAI ----
# Required for generating embeddings and chat responses.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- Vector Database Selection ----
# One of: chroma | pinecone | qdrant
VECTOR_DB_PROVIDER=chroma

# ---- Chroma (local, no API key needed) ----
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=documents

# ---- Pinecone ----
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=ai-search-engine
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Qdrant ----
# Use a local Qdrant instance or Qdrant Cloud.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# ---- App Settings ----
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# ---- Chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval ----
TOP_K_RESULTS=5

# ---- Storage ----
SQLITE_DB_PATH=./app_data.db
UPLOAD_DIR=./uploads
